{
  "branch": "main",
  "requiredStatusChecks": [
    "typecheck",
    "test",
    "strategy-verify"
  ],
  "strictStatusChecks": true,
  "requiredApprovingReviewCount": 0,
  "dismissStaleReviews": false,
  "requireCodeOwnerReview": false,
  "requireConversationResolution": false,
  "allowForcePushes": false,
  "allowDeletions": false,
  "enforceAdmins": true,
  "repositoryAutoMergeEnabled": false,
  "safeAutoMergeVariableEnabled": false,
  "workflowPullRequestCreationEnabled": false,
  "appliedAndVerified": true,
  "applicationAuthority": "deterministic-ci-only",
  "reviewGateEnabled": false,
  "humanEscalation": {
    "role": "servant-leader",
    "routineApprovalGate": false,
    "operatingBody": false,
    "allowedReasons": [
      "owner-credential",
      "physical-presence",
      "legal-consent",
      "constitutional-conflict"
    ],
    "minimumAutomatedAttempts": 2,
    "evidenceRequired": true,
    "boundedDecisionRequired": true
  },
  "notes": "Deterministic CI is the sole checked-in update gate. No review classifier, special merge policy, or model reviewer controls repository updates."
}
